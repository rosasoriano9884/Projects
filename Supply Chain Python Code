# Supply Chain Shockwave Engine
# Includes Simulation + Conditional Probability + Analysis

#Import
import random
import csv

# DATA STORAGE
# _____________________________
# Stores Inventory, Demand, Delay, and Shortage Values

inventory_history = []
demand_history = []
delay_history = []
shortage_history = []

# Stores 0 or 1 Values for Conditional Probability

high_demand_history = []
high_delay_history = []



# SYSTEM INFORMATION
# _____________________________

def info():

    print("\nSystem Information")
    print("_____________________________")

    print("This model simulates a supply chain system with:")
    print("- Changes in customer demand")
    print("- Random delays and inventory shocks")
    print("- Conditional probability analysis")
    print("- Data export for analysis in R")

    print("\nIt provides important information about:")
    print("- System stability")
    print("- Risk of shortages")
    print("- Impact of delays and demand spikes")
    print("- Inventory changes over time")

    print("_____________________________\n")


# SIMULATION
# _____________________________

def simulate():

    # Clear previous simulation results

    inventory_history.clear()
    demand_history.clear()
    delay_history.clear()
    shortage_history.clear()
    high_demand_history.clear()
    high_delay_history.clear()

    print("_____________________________")
    print("\nLet's take a look at your operation!")
    print("Fill out the following information below.")
    print("_____________________________")

    inventory = float(input("Starting inventory: "))
    supply = float(input("Supply Rate per Step: "))
    base_demand = float(input("Base demand: "))

    # Delay factor must be 0 or 1

    while True:

        delay_factor = input("Delay Factor (0 or 1): ")

        if delay_factor == "0" or delay_factor == "1":

            delay_factor = float(delay_factor)
            break

        else:

            print("Please select either 0 or 1")

    steps = int(input("Simulation Steps: "))

    print("\nSimulation Complete. Look at your results below.\n")

    for t in range(steps):

        # Random delay in the system

        delay = random.uniform(0, delay_factor)

        # Random change in demand

        demand_spike = random.uniform(0.7, 1.5)
        demand = base_demand * demand_spike

        # Inventory Change Formula
        # dI = Supply - Demand - Delay Impact

        dI = supply - demand - (delay * demand)

        inventory = inventory + dI

        # Inventory cannot fall below zero

        if inventory < 0:

            inventory = 0

        # Shortage Status

        if inventory < demand * 2:

            shortage = 1

        else:

            shortage = 0

        # High Demand Status

        if demand > base_demand * 1.2:

            high_demand = 1

        else:

            high_demand = 0

        # High Delay Status

        if delay_factor > 0 and delay > delay_factor * 0.6:

            high_delay = 1

        else:

            high_delay = 0

        # Store actual values

        inventory_history.append(inventory)
        demand_history.append(demand)
        delay_history.append(delay)
        shortage_history.append(shortage)

        # Store 0 or 1 values

        high_demand_history.append(high_demand)
        high_delay_history.append(high_delay)

        print("Step:", t + 1)
        print("Inventory:", round(inventory, 2))
        print("Demand:", round(demand, 2))
        print("Delay:", round(delay, 2))
        print("Shortage:", shortage)
        print("_____________________________")


# CONDITIONAL PROBABILITY
# _____________________________

def probability():

    if len(shortage_history) == 0:

        print("\nRun simulation first on the main menu.")
        return

    print("\nConditional Probability Analysis")
    print("_____________________________")

    total = len(shortage_history)

    demand_count = 0
    demand_shortage = 0

    delay_count = 0
    delay_shortage = 0

    total_shortage = sum(shortage_history)

    for i in range(total):

        # P(Shortage | High Demand)

        if high_demand_history[i] == 1:

            demand_count += 1

            if shortage_history[i] == 1:

                demand_shortage += 1

        # P(Shortage | High Delay)

        if high_delay_history[i] == 1:

            delay_count += 1

            if shortage_history[i] == 1:

                delay_shortage += 1

    if demand_count > 0:

        print(
            "P(Shortage | High Demand):",
            round(demand_shortage / demand_count, 3)
        )

    else:

        print("P(Shortage | High Demand): No data")

    if delay_count > 0:

        print(
            "P(Shortage | High Delay):",
            round(delay_shortage / delay_count, 3)
        )

    else:

        print("P(Shortage | High Delay): No data")

    print(
        "Base shortage rate:",
        round(total_shortage / total, 3)
    )

    print("_____________________________\n")

# SYSTEM ANALYSIS
# _____________________________

def analysis():

    if len(inventory_history) == 0:

        print("\nRun simulation first on the main menu.")
        return

    print("\nSystem Analysis")
    print("_____________________________")

    average_inventory = (
        sum(inventory_history) /
        len(inventory_history)
    )

    maximum_inventory = max(inventory_history)
    minimum_inventory = min(inventory_history)

    shortage_rate = (
        sum(shortage_history) /
        len(shortage_history)
    )

    print("Average Inventory:", round(average_inventory, 2))
    print("Maximum Inventory:", round(maximum_inventory, 2))
    print("Minimum Inventory:", round(minimum_inventory, 2))
    print("Shortage Rate:", round(shortage_rate, 3))

    if shortage_rate > 0.5:

        print("\nSYSTEM STATUS: UNSTABLE")
        print("High shortage risk detected.")

    elif shortage_rate > 0.2:

        print("\nSYSTEM STATUS: MODERATE")
        print("Continue monitoring the supply chain.")

    else:

        print("\nSYSTEM STATUS: STABLE")
        print("The inventory system looks healthy.")

    print("_____________________________\n")


# GRAPH
# _____________________________

def graph():

    if len(inventory_history) == 0:

        print("\nRun simulation first.")
        return

    print("\nInventory Over Time")
    print("_____________________________")

    for i in range(len(inventory_history)):

        print(
            "Step:",
            i + 1,
            "| Inventory:",
            round(inventory_history[i], 1),
            "#" * int(inventory_history[i] / 2)
        )

    print("_____________________________\n")



# EXPORT DATA TO CSV
# _____________________________

def export_data():

    if len(inventory_history) == 0:

        print("\nRun simulation first.")
        return

    file = open(
        "supply_chain_simulation.csv",
        "w",
        newline=""
    )

    writer = csv.writer(file)

    writer.writerow([
        "time",
        "inventory",
        "demand",
        "delay",
        "high_demand",
        "high_delay",
        "shortage"
    ])

    for i in range(len(inventory_history)):

        writer.writerow([
            i + 1,
            round(inventory_history[i], 2),
            round(demand_history[i], 2),
            round(delay_history[i], 2),
            high_demand_history[i],
            high_delay_history[i],
            shortage_history[i]
        ])

    file.close()

    print("\nData exported to supply_chain_simulation.csv.")
    print("The file is ready to import into R.\n")



