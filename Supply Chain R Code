# Regression Line of Inventory Shockwave Trend

inventory_graph = ggplot(data = supply_chain,
  aes(x = time, y = inventory)
) +
  geom_point(
    color = "blue",
    size = 3
  ) +
  
  geom_smooth(
    method = "lm",
    formula = y ~ x,
    se = TRUE,
    color = "green",
    linewidth = 2
  ) +
  labs(
    title = "Inventory Shockwave Trend",
    x = "Simulation Step",
    y = "Inventory Level"
  ) +
  theme_dark()

print(inventory_graph)


# Demand Graph Shockwave Trend

demand_graph = ggplot(
  data = supply_chain,
  aes(x = time, y = demand)
) +
  geom_line(
    color = "green",
    linewidth = 2
  ) +
  geom_point(
    color = "blue",
    size = 3
  ) +
  labs(
    title = "Demand Shockwave Trend",
    x = "Simulation Step",
    y = "Demand Level"
  ) +
  theme_dark()

print(demand_graph)


# Inventory Distribution Histogram

inventory_histogram = ggplot(
  data = supply_chain,
  aes(x = inventory)
) +
  geom_histogram(
    bins = 5,
    fill = "blue",
    color = "green"
  ) +
  labs(
    title = "Inventory Distribution",
    x = "Inventory Level",
    y = "Frequency"
  ) +
  theme_dark()

print(inventory_histogram)


